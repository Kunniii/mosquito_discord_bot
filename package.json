{
  "name": "mosquito_discord_bot",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "npm run deploy && npm run server",
    "server": "node --env-file-if-exists=.env src/index.ts",
    "deploy": "node --env-file-if-exists=.env src/deploy-command.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "@discordjs/opus": "^0.9.0",
    "@discordjs/rest": "^2.3.0",
    "@discordjs/voice": "^0.17.0",
    "discord-api-types": "^0.37.93",
    "discord.js": "^14.15.3",
    "ffmpeg-static": "^5.2.0",
    "libsodium-wrappers": "^0.7.14",
    "opusscript": "^0.0.8",
    "sodium-native": "^5.2.1",
    "tweetnacl": "^1.0.3"
  }
}
